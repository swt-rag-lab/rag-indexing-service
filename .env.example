########################################
# Application
########################################

APP_NAME=indexing-service
APP_VERSION=0.1.0
APP_ENV=development
PORT=8003

########################################
# PostgreSQL
########################################

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/indexing

########################################
# Qdrant
########################################

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents

########################################
# OpenAI
########################################

OPENAI_API_KEY=sk-your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDING_BATCH_SIZE=100
EMBEDDING_PROVIDER=openai

########################################
# MinIO
########################################

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_READ=processed-documents
MINIO_SECURE=false

########################################
# RabbitMQ
########################################

RABBITMQ_URL=amqp://rabbitmq:rabbitmq@localhost:5672/rag-lab
RABBITMQ_EXCHANGE=rag.documents.events
RABBITMQ_CONSUMER_QUEUE=indexing.document.ready_for_indexing
RABBITMQ_CONSUMER_ROUTING_KEY=document.ready_for_indexing.v1
RABBITMQ_PREFETCH_COUNT=5
RABBITMQ_MAX_RETRIES=3

########################################
# Chunking
########################################

CHUNKING_MAX_TOKENS=1024
CHUNKING_HARD_MAX_TOKENS=2048
CHUNKING_OVERLAP_TOKENS=200
CHUNKING_VERSION=semantic-v1

########################################
# Outbox
########################################

OUTBOX_POLL_INTERVAL=1.0
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=5

########################################
# Logging
########################################

LOG_LEVEL=INFO
LOG_FORMAT=json
